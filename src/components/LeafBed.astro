---
/* The strip at the bottom of the home page where fallen leaves collect.
   It's one big button: press anywhere on the pile to kick up leaves. */
import { site } from "../content/site";
import { href } from "../lib/helpers";

const sprites = site.leaves.spriteImages.map((p) => href(p));
---

<button type="button" class="leaf-bed" aria-label={site.leaves.pileLabel} data-sprites={JSON.stringify(sprites)}
></button>

<script>
  import { LeafField } from "../scripts/leaves";

  const canvas = document.querySelector<HTMLCanvasElement>(".leaf-canvas");
  const bed = document.querySelector<HTMLButtonElement>(".leaf-bed");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && bed) {
    if (reduced) {
      // A static pile only: nothing to press.
      bed.disabled = true;
      bed.tabIndex = -1;
      bed.setAttribute("aria-hidden", "true");
    }
    const field = new LeafField({
      canvas,
      bed,
      spriteUrls: JSON.parse(bed.dataset.sprites || "[]"),
      reducedMotion: reduced,
    });

    field.init().then(() => {
      const root = document.documentElement;
      // If the opening animation is playing, start the leaves when the envelope opens.
      if (root.classList.contains("intro-play") && !root.dataset.introOpened) {
        document.addEventListener("kp:intro-open", () => field.begin(), { once: true });
      } else {
        field.begin();
      }
    });
  }
</script>

<style>
  /* Full-bleed strip: spans the whole screen width. */
  .leaf-bed {
    display: block;
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 10rem;
    margin-top: var(--space-3);
    margin-bottom: calc(-1 * var(--space-5));
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .leaf-bed:disabled {
    cursor: default;
  }

  .leaf-bed:focus-visible {
    outline-offset: -6px;
  }

  @media (min-width: 40rem) {
    .leaf-bed {
      height: 12rem;
      margin-top: var(--space-4);
    }
  }
</style>
