---
/* A soft candlelight that follows the mouse over the background.
   Desktop (fine pointer) only; off for touch and reduced motion. */
---

<div class="candle-glow" aria-hidden="true"></div>

<script>
  const glow = document.querySelector<HTMLElement>(".candle-glow");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (glow && fine && !reduced) {
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0, last = 0, shown = false;

    const tick = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      const k = 1 - Math.exp(-8 * dt); // smooth, slightly lagging like a flame
      x += (tx - x) * k;
      y += (ty - y) * k;
      glow.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
    };

    window.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      tx = e.clientX;
      ty = e.clientY;
      if (!shown) {
        x = tx;
        y = ty;
        shown = true;
        glow.classList.add("is-on");
      }
      if (!raf) {
        last = performance.now();
        raf = requestAnimationFrame(tick);
      }
    }, { passive: true });

    document.documentElement.addEventListener("mouseleave", () => {
      glow.classList.remove("is-on");
      shown = false;
    });
  }
</script>

<style>
  .candle-glow {
    position: fixed;
    top: 0;
    left: 0;
    width: 44rem;
    height: 44rem;
    margin: -22rem 0 0 -22rem;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(circle closest-side, var(--glow-color), transparent);
    opacity: 0;
    transition: opacity 1.2s var(--ease-soft);
    will-change: transform;
  }

  .candle-glow:global(.is-on) {
    opacity: 1;
  }
</style>
