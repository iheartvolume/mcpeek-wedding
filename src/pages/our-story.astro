---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import StoryPhoto from "../components/StoryPhoto.astro";
import { site } from "../content/site";

const { story } = site;
const cardPhotoSizes = "(min-width: 32rem) 26rem, calc(100vw - 7rem)";
const pairPhotoSizes = "(min-width: 48rem) 18rem, calc(100vw - 7rem)";
---

<BaseLayout title={story.title}>
  <!-- Hide sections before first paint so they can fade in as you scroll.
       Skipped with reduced motion; a failsafe shows everything if scripts fail. -->
  <script is:inline slot="before">
    (function () {
      var d = document.documentElement;
      if (!("IntersectionObserver" in window)) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      d.classList.add("story-reveal");
      setTimeout(function () {
        if (!d.dataset.revealReady) d.classList.remove("story-reveal");
      }, 4000);
    })();
  </script>

  <div class="container">
    <PageTitle title={story.title} intro={story.intro} />

    {
      story.headerPhoto.file && (
        <div class="header-photo">
          <StoryPhoto photo={story.headerPhoto} sizes="(min-width: 32rem) 28rem, calc(100vw - 2rem)" eager />
        </div>
      )
    }

    <ol class="timeline">
      {
        story.milestones.map((m) => (
          <li class="milestone" data-reveal>
            <span class="marker" aria-hidden="true" />
            <article class="card">
              {m.when && <p class="label when">{m.when}</p>}
              <h2 class="script">{m.title}</h2>
              <div class="divider" aria-hidden="true">
                <span />
              </div>
              <div class="body">
                {m.body.map((block) =>
                  typeof block === "string" ? (
                    <p>{block}</p>
                  ) : (
                    <div class:list={["photos", block.photos.length > 1 && "multi"]}>
                      {block.photos.map((p) => (
                        <StoryPhoto photo={p} sizes={block.photos.length > 1 ? pairPhotoSizes : cardPhotoSizes} />
                      ))}
                    </div>
                  ),
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ol>

    {
      story.closingPhoto.file && (
        <div class="closing" data-reveal>
          <div class="divider" aria-hidden="true">
            <span />
          </div>
          <StoryPhoto photo={story.closingPhoto} sizes="(min-width: 48rem) 30rem, calc(100vw - 4rem)" />
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  const root = document.documentElement;
  root.dataset.revealReady = "1";

  if (root.classList.contains("story-reveal")) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
    );
    document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
  }
</script>

<style>
  .header-photo {
    max-width: 28rem;
    margin: 0 auto var(--space-4);
  }

  /* --- Timeline: a thin gold line down the left -------------------------- */
  .timeline {
    --line-x: 0.6rem;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: var(--line-x);
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--accent) 4rem, var(--accent) calc(100% - 4rem), transparent);
    opacity: 0.7;
  }

  .milestone {
    position: relative;
    padding-left: calc(var(--line-x) + 1.5rem);
  }

  .milestone + .milestone {
    margin-top: var(--space-4);
  }

  /* Small gold diamond on the line */
  .marker {
    position: absolute;
    left: var(--line-x);
    top: 2.6rem;
    width: 11px;
    height: 11px;
    background: var(--accent);
    transform: translate(-50%, -50%) rotate(45deg);
    box-shadow: 0 0 0 4px var(--surface-page);
  }

  .milestone .card {
    padding-inline: var(--space-2);
  }

  .when,
  .milestone h2 {
    text-align: center;
  }

  .when {
    margin-bottom: var(--space-1);
  }

  .milestone .divider {
    margin-top: 0;
  }

  .body > * + * {
    margin-top: var(--space-3);
  }

  .body p {
    margin-bottom: 0;
  }

  .photos {
    display: grid;
    gap: var(--space-2);
  }

  /* A single photo stays a comfortable size, centered. */
  .photos:not(.multi) {
    max-width: 26rem;
    margin-inline: auto;
  }

  /* --- Closing photo ---------------------------------------------------- */
  .closing {
    max-width: 30rem;
    margin: var(--space-4) auto 0;
  }

  .closing .divider {
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 40rem) {
    .milestone .card {
      padding-inline: var(--space-4);
    }

    /* Two or more photos: two columns in reading order, each photo keeps its own shape. */
    .photos.multi {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  @media (min-width: 64rem) {
    .timeline {
      --line-x: -2.5rem;
    }

    .milestone {
      padding-left: 0;
    }
  }

  /* --- Scroll reveal (only when motion is welcome) --------------------- */
  :global(html.story-reveal) [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 900ms var(--ease-soft),
      transform 900ms var(--ease-soft);
  }

  :global(html.story-reveal) [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
</style>
