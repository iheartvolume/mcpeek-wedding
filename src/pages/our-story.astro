---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import StoryPhoto from "../components/StoryPhoto.astro";
import { site } from "../content/site";

const { story } = site;
---

<BaseLayout title={story.title}>
  <!-- Hide milestones before first paint so they can fade in as you scroll.
       Skipped with reduced motion; a failsafe shows everything if scripts fail. -->
  <script is:inline slot="before">
    (function () {
      var d = document.documentElement;
      if (!("IntersectionObserver" in window)) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      d.classList.add("story-reveal");
      setTimeout(function () {
        if (!d.dataset.revealReady) d.classList.remove("story-reveal");
      }, 4000);
    })();
  </script>

  <div class="container-wide">
    <PageTitle title={story.title} intro={story.intro} />

    <ol class="timeline">
      {
        story.milestones.map((m, i) => (
          <li class:list={["milestone", i % 2 ? "right" : "left"]} data-reveal>
            <span class="marker" aria-hidden="true" />
            <p class="when-aside label" aria-hidden="true">{m.when}</p>
            <article class="card">
              <p class="label when">{m.when}</p>
              <h2 class="script">{m.title}</h2>
              <StoryPhoto photo={m.photo} alt={m.photoAlt} sizes="(min-width: 56rem) 28rem, calc(100vw - 6rem)" />
              <p class="text">{m.text}</p>
            </article>
          </li>
        ))
      }
    </ol>

    {
      story.gallery.length > 0 && (
        <section class="gallery" aria-labelledby="gallery-title" data-reveal>
          <h2 id="gallery-title" class="script">{story.galleryTitle}</h2>
          <div class="divider" aria-hidden="true">
            <span />
          </div>
          <ul class="grid">
            {story.gallery.map((g) => (
              <li>
                <StoryPhoto photo={g.photo} alt={g.alt} ratio="1 / 1" sizes="(min-width: 56rem) 20rem, 45vw" />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  const root = document.documentElement;
  root.dataset.revealReady = "1";
  const items = document.querySelectorAll<HTMLElement>("[data-reveal]");

  if (root.classList.contains("story-reveal")) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* --- Timeline: line on the left on phones, centered on wide screens --- */
  .timeline {
    --line-x: 0.75rem;
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--content-width);
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: var(--line-x);
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--accent) 4rem, var(--accent) calc(100% - 4rem), transparent);
    opacity: 0.7;
  }

  .milestone {
    position: relative;
    padding-left: calc(var(--line-x) + 1.75rem);
  }

  .milestone + .milestone {
    margin-top: var(--space-4);
  }

  /* Small gold diamond on the line */
  .marker {
    position: absolute;
    left: var(--line-x);
    top: 2.4rem;
    width: 11px;
    height: 11px;
    background: var(--accent);
    transform: translate(-50%, -50%) rotate(45deg);
    box-shadow: 0 0 0 4px var(--surface-page);
  }

  .when-aside {
    display: none;
  }

  .milestone .card {
    text-align: center;
  }

  .when {
    margin-bottom: var(--space-1);
  }

  .milestone :global(.photo) {
    margin: var(--space-3) 0;
  }

  .text {
    text-align: left;
  }

  /* --- Gallery ------------------------------------------------------- */
  .gallery {
    margin-top: var(--space-5);
    text-align: center;
  }

  .gallery h2 {
    margin-bottom: 0;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  /* --- Wide screens: centered line, alternating sides ------------------ */
  @media (min-width: 56rem) {
    .timeline {
      --line-x: 50%;
      max-width: var(--wide-width);
    }

    .milestone {
      width: 50%;
      padding-left: 0;
    }

    .milestone.left {
      padding-right: 3rem;
    }

    .milestone.right {
      margin-left: 50%;
      padding-left: 3rem;
    }

    .milestone + .milestone {
      margin-top: calc(-1 * var(--space-5));
    }

    .marker {
      left: auto;
      top: 3rem;
    }

    .milestone.left .marker {
      right: 0;
      transform: translate(50%, -50%) rotate(45deg);
    }

    .milestone.right .marker {
      left: 0;
    }

    /* The year sits across the line from its card, in gold on maroon. */
    .when-aside {
      display: block;
      position: absolute;
      top: 3rem;
      transform: translateY(-50%);
      margin: 0;
      color: var(--accent);
      font-size: var(--text-base);
      white-space: nowrap;
    }

    .milestone.left .when-aside {
      left: calc(100% + 2rem);
    }

    .milestone.right .when-aside {
      right: calc(100% + 2rem);
    }

    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-3);
    }
  }

  /* --- Scroll reveal (only when motion is welcome) --------------------- */
  :global(html.story-reveal) [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 900ms var(--ease-soft),
      transform 900ms var(--ease-soft);
  }

  :global(html.story-reveal) [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 56rem) {
    :global(html.story-reveal) .milestone.left:not(.is-visible) {
      transform: translate(-24px, 16px);
    }

    :global(html.story-reveal) .milestone.right:not(.is-visible) {
      transform: translate(24px, 16px);
    }
  }
</style>
