---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import { site } from "../content/site";
import { mapsLink } from "../lib/helpers";

const { travel } = site;
const L = travel.hotelLabels;
const tel = (phone: string) => `tel:+1${phone.replace(/\D/g, "").replace(/^1(?=\d{10}$)/, "")}`;
---

<BaseLayout title={travel.title}>
  <div class="container stack">
    <PageTitle title={travel.title} intro={travel.intro} />

    <!-- The one note nobody should miss -->
    <aside class="card notice" aria-labelledby="notice-title">
      <p class="label eyebrow">{travel.notice.eyebrow}</p>
      <h2 id="notice-title" class="script">{travel.notice.title}</h2>
      <p>{travel.notice.text}</p>
      <p class="action">{travel.notice.action}</p>
    </aside>

    <section class="card" aria-labelledby="notes-title">
      <h2 id="notes-title" class="script center">{travel.notesTitle}</h2>
      <div class="divider" aria-hidden="true"><span></span></div>
      <div class="notes">
        {
          travel.notes.map((n) => (
            <div class="note">
              <h3 class="label">{n.heading}</h3>
              {n.text.map((t) => (
                <p>{t}</p>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <h2 class="script section-title">{travel.accommodationsTitle}</h2>

    {
      travel.hotelGroups.map((group) => (
        <section class="card" aria-label={group.town}>
          <h3 class="script center town">{group.town}</h3>
          <div class="divider" aria-hidden="true">
            <span />
          </div>
          <ul class="hotels">
            {group.hotels.map((h) => (
              <li class="hotel">
                <h4 class="hotel-name">
                  {h.url ? (
                    <a href={h.url} target="_blank" rel="noopener">
                      {h.name}
                      <span class="visually-hidden"> {L.website}</span>
                    </a>
                  ) : (
                    h.name
                  )}
                </h4>
                <p class="contact">
                  <a href={mapsLink(h.name, h.address)} target="_blank" rel="noopener">
                    {h.address}
                    <span class="visually-hidden"> {L.maps}</span>
                  </a>
                  {h.phone && (
                    <>
                      <br />
                      <a href={tel(h.phone)}>{h.phone}</a>
                    </>
                  )}
                </p>
                <dl class="details">
                  {h.parking && (
                    <div>
                      <dt class="label">{L.parking}</dt>
                      <dd>{h.parking}</dd>
                    </div>
                  )}
                  {h.breakfast && (
                    <div>
                      <dt class="label">{L.breakfast}</dt>
                      <dd>{h.breakfast}</dd>
                    </div>
                  )}
                  {h.location && (
                    <div>
                      <dt class="label">{L.location}</dt>
                      <dd>{h.location}</dd>
                    </div>
                  )}
                  {h.goodToKnow && (
                    <div>
                      <dt class="label">{L.goodToKnow}</dt>
                      <dd>{h.goodToKnow}</dd>
                    </div>
                  )}
                </dl>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="card" aria-labelledby="getting-there">
      <h2 id="getting-there" class="script center">{travel.gettingThereTitle}</h2>
      <div class="divider" aria-hidden="true"><span></span></div>
      <div class="notes">
        {
          travel.gettingThere.map((g) => (
            <div class="note">
              <h3 class="label">{g.heading}</h3>
              <p>{g.text}</p>
            </div>
          ))
        }
      </div>
      {
        travel.mapEmbedUrl ? (
          <div class="map-frame">
            <iframe src={travel.mapEmbedUrl} title={travel.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
          </div>
        ) : (
          travel.mapLink && (
            <p class="map-link">
              <a class="button" href={travel.mapLink} target="_blank" rel="noopener">
                {travel.mapLinkLabel}
                <span class="visually-hidden"> {L.maps}</span>
              </a>
            </p>
          )
        )
      }
    </section>

    {
      travel.exploreGroups.length > 0 && (
        <section class="card" aria-labelledby="explore">
          <h2 id="explore" class="script center">
            {travel.exploreTitle}
          </h2>
          {travel.exploreGroups.map((group) => (
            <div class="group">
              <h3 class="label center">{group.category}</h3>
              <ul class="list">
                {group.items.map((item) => (
                  <li>
                    <p class="item-name">{item.url ? <a href={item.url}>{item.name}</a> : item.name}</p>
                    <p>{item.note}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .center {
    text-align: center;
  }

  /* --- Football notice: gold frame so it stands out ------------------- */
  .notice {
    text-align: center;
    border: 2px solid var(--accent);
    box-shadow: 0 0 28px 4px var(--glow-color);
  }

  .notice::before {
    border-color: var(--accent);
  }

  .eyebrow {
    margin-bottom: var(--space-1);
  }

  .action {
    font-weight: 700;
  }

  /* --- Notes ------------------------------------------------------------ */
  .note + .note {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-card);
  }

  .note h3 {
    margin-bottom: var(--space-1);
  }

  .note p + p {
    margin-top: var(--space-1);
  }

  /* --- Hotels ----------------------------------------------------------- */
  .section-title {
    text-align: center;
    color: var(--text-on-page);
    margin: var(--space-4) 0 0;
  }

  .town {
    font-size: var(--heading-md);
    margin-bottom: 0;
  }

  .hotels {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hotel + .hotel {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-card);
  }

  .hotel-name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 var(--space-1);
  }

  .contact {
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .details {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .details dt {
    margin-bottom: 0.15rem;
  }

  .details dd {
    margin: 0;
  }

  /* --- Map -------------------------------------------------------------- */
  .map-link {
    margin-top: var(--space-3);
    text-align: center;
  }

  .map-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    margin-top: var(--space-3);
    border: 1px solid var(--border-card);
  }

  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* --- Eat & Explore (shown once it has entries) ------------------------ */
  .list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  .list > li + li {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-card);
  }

  .item-name {
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .group + .group {
    margin-top: var(--space-4);
  }

  @media (min-width: 40rem) {
    /* Labels in a narrow column beside their details. */
    .details > div {
      display: grid;
      grid-template-columns: 10rem 1fr;
      gap: var(--space-2);
    }

    .details dt {
      margin: 0.2rem 0 0;
    }

    .map-frame {
      aspect-ratio: 16 / 10;
    }
  }
</style>
