---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
import { daysUntil, formatLongDate, href } from "../lib/helpers";

const { couple, home, ceremony, weddingDate } = site;
const buildDays = daysUntil(weddingDate);
---

<BaseLayout>
  <div class="container">
    <section class="card card-center hero" aria-labelledby="hero-names">
      <p class="label eyebrow">{home.eyebrow}</p>
      <h1 id="hero-names" class="names script">
        <span>{couple.first}</span>
        <span class="joiner">{couple.joiner}</span>
        <span>{couple.second}</span>
      </h1>
      <p class="intro">{home.intro}</p>

      <div class="divider" aria-hidden="true"><span></span></div>

      <p class="date">{formatLongDate(weddingDate)}</p>
      <p class="place">
        {ceremony.mapsUrl ? <a href={ceremony.mapsUrl}>{ceremony.venue}</a> : ceremony.venue}
        <br />
        <span class="address">{ceremony.address}</span>
      </p>

      <p
        class="countdown label"
        data-countdown
        data-date={weddingDate}
        data-suffix={home.countdownSuffix}
        data-today={home.countdownToday}
        data-past={home.countdownPast}
      >
        {buildDays > 0 ? `${buildDays} ${home.countdownSuffix}` : buildDays === 0 ? home.countdownToday : home.countdownPast}
      </p>

      <div class="button-row links">
        {home.links.map((link) => <a class="button" href={href(link.path)}>{link.label}</a>)}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { daysUntil } from "../lib/dates";

  // Keep the countdown current between site rebuilds.
  const el = document.querySelector<HTMLElement>("[data-countdown]");
  if (el?.dataset.date) {
    const days = daysUntil(el.dataset.date);
    el.textContent =
      days > 0 ? `${days} ${el.dataset.suffix}` : days === 0 ? (el.dataset.today ?? "") : (el.dataset.past ?? "");
  }
</script>

<style>
  .hero {
    margin-top: var(--space-2);
  }

  .eyebrow {
    margin-bottom: var(--space-3);
  }

  .names {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: var(--heading-xl);
    line-height: 1.05;
    margin-bottom: var(--space-2);
  }

  .joiner {
    font-size: 0.6em;
    line-height: 1.2;
  }

  .intro {
    font-style: italic;
  }

  .date {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .place {
    margin-bottom: var(--space-3);
  }

  .address {
    font-size: var(--text-sm);
  }

  .countdown {
    margin-bottom: var(--space-4);
  }
</style>
